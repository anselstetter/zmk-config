/*
 * Corne Choc Pro BT — ZMK keymap
 *
 * Each half has a display physically occupying what would have been
 * 2 switch positions. So 4 keymap matrix positions are unwired (bound
 * to &none): row 1 col 7, row 2 col 7 (left display), row 1 col 8,
 * row 2 col 8 (right display) — i.e. the four middle positions on
 * rows 1 and 2.
 *
 * Layers:
 *   0 = BASE   (QWERTY, Linux default)
 *   1 = MAC    (overlay; activated when on BT profile 1 via &bt_mac)
 *   2 = NAV    (numbers, F-keys, vim arrows)
 *   3 = DEV    (symbols, brackets)
 *   4 = ADJ    (BT, system, RGB, Studio) — auto-activated by NAV+DEV
 *   5-10       (reserved empty layers for future ZMK Studio editing)
 *
 * Tri-layer: holding NAV (left thumb middle) + DEV (right thumb middle)
 * activates ADJ. No explicit binding needed.
 *
 * OS switching: BT profile 0 = Linux (BASE), BT profile 1 = Mac (MAC overlay).
 * Use the &bt_linux / &bt_mac macros on the ADJ layer to switch.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define MAC  1
#define NAV  2
#define DEV  3
#define ADJ  4

/ {
    chosen { zmk,physical-layout = &default_layout; };

    // Tri-layer: hold NAV + DEV together => ADJ activates automatically.
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NAV DEV>;
            then-layer = <ADJ>;
        };
    };

    macros {
        // Switch to Linux: BT profile 0, return to BASE
        bt_linux: bt_linux {
            label = "BT_LINUX";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&bt BT_SEL 0>
                , <&to BASE>;
        };

        // Switch to Mac: BT profile 1, activate MAC overlay
        bt_mac: bt_mac {
            label = "BT_MAC";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&bt BT_SEL 1>
                , <&to MAC>;
        };

        // Mac umlauts: Option+U (dead key for diaeresis), then the vowel.
        // Requires macOS input source = "ABC" (default on modern macOS works fine).
        //
        // Lower vs upper handling:
        //   The outer RALT mod-morph (a_ae_mac etc.) masks RALT cleanly.
        //   An inner mod-morph (ae_mac_morph etc.) then branches on Shift:
        //     - no shift held  -> lower macro (Option+U then a)
        //     - shift held     -> upper macro: shift is masked by the morph
        //                         (default behavior, since `mods` includes shift
        //                         and `keep-mods` is omitted), so Option+U fires
        //                         with clean modifier state, then shift is
        //                         re-applied only for the final letter so the
        //                         dead-key composes into the capital umlaut.
        //
        // Without the masking, Shift would leak into Option+U and macOS would
        // emit the bare diaeresis character followed by the capital letter
        // (two characters, not one composed glyph).

        mac_ae_lower: mac_ae_lower {
            label = "MAC_AE_LOWER";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp RA(U)>
                , <&macro_tap &kp A>;
        };

        mac_ae_upper: mac_ae_upper {
            label = "MAC_AE_UPPER";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap     &kp RA(U)>
                , <&macro_press   &kp LSHFT>
                , <&macro_tap     &kp A>
                , <&macro_release &kp LSHFT>;
        };

        mac_oe_lower: mac_oe_lower {
            label = "MAC_OE_LOWER";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp RA(U)>
                , <&macro_tap &kp O>;
        };

        mac_oe_upper: mac_oe_upper {
            label = "MAC_OE_UPPER";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap     &kp RA(U)>
                , <&macro_press   &kp LSHFT>
                , <&macro_tap     &kp O>
                , <&macro_release &kp LSHFT>;
        };

        mac_ue_lower: mac_ue_lower {
            label = "MAC_UE_LOWER";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp RA(U)>
                , <&macro_tap &kp U>;
        };

        mac_ue_upper: mac_ue_upper {
            label = "MAC_UE_UPPER";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap     &kp RA(U)>
                , <&macro_press   &kp LSHFT>
                , <&macro_tap     &kp U>
                , <&macro_release &kp LSHFT>;
        };
    };

    behaviors {
        // Layer-tap: tap = key, hold = momentary layer.
        // retro-tap: if held without pressing another key, still emits the tap on release.
        lt_to_layer: lt_to_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_TO_LAYER";
            bindings = <&mo>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            retro-tap;
        };

        // German umlauts via Right Alt:
        // Tap A/O/U/S => normal letter.
        // Hold RALT + tap => umlaut/eszett (decoded by OS layout, e.g.
        // 'English (US, intl., with dead keys)' on Linux,
        // 'U.S. International - PC' on macOS).
        a_ae: a_ae {
            compatible = "zmk,behavior-mod-morph";
            label = "A_AE";
            bindings = <&kp A>, <&kp RA(Q)>;
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        o_oe: o_oe {
            compatible = "zmk,behavior-mod-morph";
            label = "O_OE";
            bindings = <&kp O>, <&kp RA(P)>;
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        u_ue: u_ue {
            compatible = "zmk,behavior-mod-morph";
            label = "U_UE";
            bindings = <&kp U>, <&kp RA(Y)>;
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        s_sz: s_sz {
            compatible = "zmk,behavior-mod-morph";
            label = "S_SZ";
            bindings = <&kp S>, <&kp RA(S)>;
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        // Mac umlaut mod-morphs:
        //   Outer (X_mac):   triggered by RALT. Default branch = plain &kp X.
        //                    Morphed branch = inner shift-morph. RALT is masked
        //                    automatically (default ZMK mod-morph behavior).
        //   Inner (X_mac_m): triggered by Shift. Default branch = lowercase macro.
        //                    Morphed branch = uppercase macro. Shift is masked
        //                    automatically, so the lowercase macro's Option+U
        //                    fires with clean modifier state; the uppercase
        //                    macro re-applies Shift only for the final letter.

        ae_mac_morph: ae_mac_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "AE_MAC_MORPH";
            bindings = <&mac_ae_lower>, <&mac_ae_upper>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        a_ae_mac: a_ae_mac {
            compatible = "zmk,behavior-mod-morph";
            label = "A_AE_MAC";
            bindings = <&kp A>, <&ae_mac_morph>;
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        oe_mac_morph: oe_mac_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "OE_MAC_MORPH";
            bindings = <&mac_oe_lower>, <&mac_oe_upper>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        o_oe_mac: o_oe_mac {
            compatible = "zmk,behavior-mod-morph";
            label = "O_OE_MAC";
            bindings = <&kp O>, <&oe_mac_morph>;
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        ue_mac_morph: ue_mac_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "UE_MAC_MORPH";
            bindings = <&mac_ue_lower>, <&mac_ue_upper>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        u_ue_mac: u_ue_mac {
            compatible = "zmk,behavior-mod-morph";
            label = "U_UE_MAC";
            bindings = <&kp U>, <&ue_mac_morph>;
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * ============================================================
         * BASE (Linux default) — Layer 0
         * ============================================================
         *
         * ,-----------------------------------.              ,-----------------------------------.
         * | TAB |  Q  |  W  |  E  |  R  |  T  |              |  Y  | U*  |  I  | O*  |  P  |BSPC |
         * |-----+-----+-----+-----+-----+-----| [DSP]  [DSP] |-----+-----+-----+-----+-----+-----|
         * |CT/ES|  A* | S/ß |  D  |  F  |  G  |              |  H  |  J  |  K  |  L  | ;/N |  '  |
         * |-----+-----+-----+-----+-----+-----|              |-----+-----+-----+-----+-----+-----|
         * |SHFT |  Z  |  X  |  C  |  V  |  B  |              |  N  |  M  |  ,  |  .  |  /  |RS/E |
         * `-----------------------------------'              `-----------------------------------'
         *               | GUI | NAV | ENT |                  | SPC | DEV |RALT |
         *               `-----------------'                  `-----------------'
         *
         * [DSP] = display position (no switch wired here, bound to &none).
         *   Each display spans 2 rows on its half of the matrix.
         *
         * * = mod-morph: hold RALT (right thumb) + tap to get the umlaut/eszett.
         *   A => ä,  O => ö,  U => ü,  S => ß
         *
         * Mod-taps:
         *   - Left pinky home row: tap = ESC, hold = LCTRL  (&mt LCTRL ESCAPE)
         *   - Right pinky bottom row: tap = ENTER, hold = RSHIFT  (&mt RSHFT ENTER)
         *
         * Layer-tap:
         *   - ;/N = tap for SEMICOLON, hold for NAV layer (&lt_to_layer NAV)
         *
         * Thumb layers:
         *   - Left thumb middle: momentary NAV
         *   - Right thumb middle: momentary DEV
         *   - Both together: ADJ (via conditional_layers)
         *
         * Note: GUI = Super on Linux. On Mac, the same physical thumb is overridden
         * to Ctrl in the MAC layer (because Mac uses Cmd as the primary modifier,
         * and we want Ctrl available too — see MAC layer below). The left pinky's
         * mod-tap is swapped to LGUI on Mac so tap=ESC still works while hold=Cmd.
         * Right Alt works as Option on Mac, so umlaut input works on both OSes
         * provided the system input source is set to a US-International variant.
         */
        base_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB           &kp Q  &kp W  &kp E     &kp R    &kp T      &none      &none      &kp Y      &u_ue    &kp I      &o_oe    &kp P                  &kp BSPC
&mt LCTRL ESCAPE  &a_ae  &s_sz  &kp D     &kp F    &kp G      &none      &none      &kp H      &kp J    &kp K      &kp L    &lt_to_layer NAV SEMI  &kp SQT
&kp LSHFT         &kp Z  &kp X  &kp C     &kp V    &kp B                            &kp N      &kp M    &kp COMMA  &kp DOT  &kp FSLH               &mt RSHFT ENTER
                                &kp LGUI  &mo NAV  &kp RET                          &kp SPACE  &mo DEV  &kp RALT
            >;
        };

        /*
         * ============================================================
         * MAC overlay — Layer 1
         * ============================================================
         *
         * ,-----------------------------------.              ,-----------------------------------.
         * |     |     |     |     |     |     |              |     |  U* |     |  O* |     |     |
         * |-----+-----+-----+-----+-----+-----| [DSP]  [DSP] |-----+-----+-----+-----+-----+-----|
         * |GU/ES|  A* |     |     |     |     |              |     |     |     |     |     |     |
         * |-----+-----+-----+-----+-----+-----|              |-----+-----+-----+-----+-----+-----|
         * |     |     |     |     |     |     |              |     |     |     |     |     |     |
         * `-----------------------------------'              `-----------------------------------'
         *               |CTRL |     |     |                  |     |     |     |
         *               `-----------------'                  `-----------------'
         *
         * Activated by &bt_mac (BT profile 1 + jump to this layer).
         *
         * Pinky-Ctrl swap to handle the Ctrl-vs-Cmd difference between OSes:
         *   - Left pinky home row: tap = ESC, hold = LGUI (Cmd) instead of LCTRL.
         *     So pinky+C still does "copy" — Cmd+C on Mac, Ctrl+C on Linux.
         *   - Left thumb GUI position: becomes LCTRL on Mac, so when you genuinely
         *     need Ctrl (e.g. Ctrl+A/E/D in shell), the thumb has it.
         *
         * Everything else is &trans and falls through to BASE.
         * Right Alt remains Right Alt = Option on Mac, so umlauts still work.
         */
        mac_layer {
            display-name = "MAC";
            bindings = <
&trans           &trans     &trans  &trans      &trans  &trans  &none  &none  &trans  &u_ue_mac  &trans  &o_oe_mac  &trans  &trans
&mt LGUI ESCAPE  &a_ae_mac  &trans  &trans      &trans  &trans  &none  &none  &trans  &trans     &trans  &trans     &trans  &trans
&trans           &trans     &trans  &trans      &trans  &trans                &trans  &trans     &trans  &trans     &trans  &trans
                                    &kp LCTRL   &trans  &trans                &trans  &trans     &trans
            >;
        };

        /*
         * ============================================================
         * NAV / NUM — Layer 2
         * ============================================================
         *
         * ,-----------------------------------.              ,-----------------------------------.
         * |     |  1  |  2  |  3  |  4  |  5  |              |  6  |  7  |  8  |  9  |  0  |     |
         * |-----+-----+-----+-----+-----+-----| [DSP]  [DSP] |-----+-----+-----+-----+-----+-----|
         * |     | F1  | F2  | F3  | F4  | F5  |              | LFT | DWN |  UP | RGT | HOM | END |
         * |-----+-----+-----+-----+-----+-----|              |-----+-----+-----+-----+-----+-----|
         * |     | F6  | F7  | F8  | F9  | F10 |              | F11 | F12 | PUP | PDN | DEL |     |
         * `-----------------------------------'              `-----------------------------------'
         *               |     |     |     |                  |     |     |     |
         *               `-----------------'                  `-----------------'
         *
         * Vim arrows on the right home row: H J K L = ← ↓ ↑ →
         * Hold NAV + DEV simultaneously to reach ADJ via the tri-layer rule.
         */
        nav_layer {
            display-name = "NAV";
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5      &none  &none      &kp N6     &kp N7    &kp N8     &kp N9     &kp N0    &trans
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5      &none  &none      &kp LEFT   &kp DOWN  &kp UP     &kp RIGHT  &kp HOME  &kp END
&trans  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10                       &kp F11    &kp F12   &kp PG_UP  &kp PG_DN  &kp DEL   &trans
                        &trans  &trans  &trans                        &trans     &trans    &trans
            >;
        };

        /*
         * ============================================================
         * DEV / Symbols — Layer 3
         * ============================================================
         *
         * ,-----------------------------------.              ,-----------------------------------.
         * |     |  !  |  @  |  #  |  $  |  %  |              |  ^  |  &  |  *  |  \  |  |  |     |
         * |-----+-----+-----+-----+-----+-----| [DSP]  [DSP] |-----+-----+-----+-----+-----+-----|
         * |     |  ~  |  `  |  -  |  _  |  +  |              |  (  |  )  |  {  |  }  |  [  |  ]  |
         * |-----+-----+-----+-----+-----+-----|              |-----+-----+-----+-----+-----+-----|
         * |     |     |  =  |  <  |  >  |  ?  |              |  /  |  :  |  ;  |  "  |  '  |     |
         * `-----------------------------------'              `-----------------------------------'
         *               |     |     |     |                  |     |     |     |
         *               `-----------------'                  `-----------------'
         *
         * Notes:
         * - All four bracket pairs (), [], {} on the right home row in
         *   left/right pair order. <> on the bottom row.
         * - Both ` and ~ available without combos (handy for shells and md).
         * - Hold NAV + DEV simultaneously to reach ADJ via the tri-layer rule.
         */
        dev_layer {
            display-name = "DEV";
            bindings = <
&trans  &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT      &none  &none      &kp CARET  &kp AMPS   &kp ASTRK  &kp BSLH  &kp PIPE  &trans
&trans  &kp TILDE  &kp GRAVE  &kp MINUS  &kp UNDER  &kp PLUS       &none  &none      &kp LPAR   &kp RPAR   &kp LBRC   &kp RBRC  &kp LBKT  &kp RBKT
&trans  &trans     &kp EQUAL  &kp LT     &kp GT     &kp QMARK                        &kp FSLH   &kp COLON  &kp SEMI   &kp DQT   &kp SQT   &trans
                              &trans     &trans     &trans                           &trans     &trans     &trans
            >;
        };

        /*
         * ============================================================
         * ADJUST — Layer 4
         * ============================================================
         * Auto-activated by the conditional_layers rule when NAV (2)
         * and DEV (3) are both held — i.e. hold both thumb-middle keys.
         *
         * ,-----------------------------------.              ,-----------------------------------.
         * |BOOT |     |     |     |     |     |              |     |     |     |     |     |BOOT |
         * |-----+-----+-----+-----+-----+-----| [DSP]  [DSP] |-----+-----+-----+-----+-----+-----|
         * |     |LINUX| MAC |     |     | RST |              | BT0 | BT1 | BT2 | BT3 | BT4 |BCLR |
         * |-----+-----+-----+-----+-----+-----|              |-----+-----+-----+-----+-----+-----|
         * |     |     |     |     |     |STDIO|              |     |     |     |     |RGBTG|     |
         * `-----------------------------------'              `-----------------------------------'
         *               |     |     |     |                  |     |     |     |
         *               `-----------------'                  `-----------------'
         *
         * - LINUX = &bt_linux  (BT profile 0 + return to BASE)
         * - MAC   = &bt_mac    (BT profile 1 + activate MAC overlay)
         * - BT0..BT4 = direct profile selection (no overlay change — useful for
         *   pairing additional devices later)
         * - BCLR  = clear current BT profile pairing (right pinky, next to BT4
         *   so the BT cluster is contiguous)
         * - RST   = sys_reset (soft reset)
         * - STDIO = studio_unlock (enable ZMK Studio editing) — placed where 'B' is
         *   on BASE so it requires a deliberate inner-column reach
         * - RGBTG = toggle RGB underglow on/off
         * - BOOT  = bootloader (top-row outer corners; deliberate reach required,
         *   one per half so you can flash each side independently)
         */
        adjust_layer {
            display-name = "ADJ";
            bindings = <
&bootloader  &none      &none    &none   &none   &none           &none  &none      &none         &none         &none         &none         &none            &bootloader
&none        &bt_linux  &bt_mac  &none   &none   &sys_reset      &none  &none      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4     &bt BT_CLR
&none        &none      &none    &none   &none   &studio_unlock                     &none         &none         &none         &none         &rgb_ug RGB_TOG  &none
                                 &trans  &trans  &trans                             &trans        &trans        &trans
            >;
        };

        // Reserved empty layers — kept so ZMK Studio can edit them later
        // without rebuilding firmware.
        extra_layer_1 {
            display-name = "EXTRA 1";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &none  &none  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none  &none  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                &trans  &trans  &trans
            >;
        };

        extra_layer_2 {
            display-name = "EXTRA 2";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &none  &none  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none  &none  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                &trans  &trans  &trans
            >;
        };

        extra_layer_3 {
            display-name = "EXTRA 3";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &none  &none  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none  &none  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                &trans  &trans  &trans
            >;
        };

        extra_layer_4 {
            display-name = "EXTRA 4";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &none  &none  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none  &none  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                &trans  &trans  &trans
            >;
        };

        extra_layer_5 {
            display-name = "EXTRA 5";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &none  &none  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none  &none  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                &trans  &trans  &trans
            >;
        };

        extra_layer_6 {
            display-name = "EXTRA 6";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &none  &none  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none  &none  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                &trans  &trans  &trans
            >;
        };
    };
};
